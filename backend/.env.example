# Database
DATABASE_URL=postgresql+psycopg://careconnect:careconnect_dev@localhost:5432/careconnect
# For local dev with SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./careconnect.db

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072

# Vector Store
VECTOR_STORE_PATH=./data/faiss_index
VECTOR_STORE_TYPE=faiss  # faiss, pgvector, weaviate

# Email (SMTP only - SendGrid not available in Lebanon)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@careconnect.health
EMAIL_FROM_NAME=CareConnect

# Auth
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_ISSUER=careconnect
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
OAUTH_PROVIDER=auth0  # auth0, email_otp
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Application
LOG_LEVEL=INFO
ENVIRONMENT=development  # development, staging, production
RATE_LIMIT_PER_MINUTE=60

# Features
ENABLE_PROMETHEUS=true
ENABLE_PRIVACY_MODE=false
MOCK_SCHEDULING=true  # Use mock scheduling client for development

# Observability
SENTRY_DSN=
